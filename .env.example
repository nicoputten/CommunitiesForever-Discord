# Example configuration (docs/ARCHITECTURE.md "Configuration"). Copy to .env for development; real values only go
# in the TrueNAS app's environment, never into the repo or a chat.

# The bot token from the Discord developer portal (Bot → Reset Token). Without it the bot logs "no token" and exits.
DISCORD_TOKEN=
# The application id (General Information → Application ID), to register the slash commands.
DISCORD_APP_ID=
# The site: https://wow.vestras.nl live, http://localhost:3000 in development.
SITE_URL=
# The site's bot token (created by the admin on the site, shown once), sent as a Bearer token to /api/bot/v1/.
BOT_API_TOKEN=
